    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst required = ['name','email','phone','company','interest'];\nconst missing = required.filter(k => !String(b[k] ?? '').trim());\nif (missing.length) throw new Error(`Missing required fields: ${missing.join(', ')}`);\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(b.email)) throw new Error('Invalid email address');\nreturn [{json:{Name:b.name,Email:b.email,Phone:b.phone,Company:b.company,Interest:b.interest,'Created At':new Date().toISOString()}}];"
      },
      "id": "2",
